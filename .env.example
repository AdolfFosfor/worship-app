# Supabase (Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Aliases (optional, same as Supabase Nuxt quickstart)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=your_anon_or_publishable_key

# Server-only secrets (never expose to the client)
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NUXT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Bot webhook (POST /api/telegram/webhook) — secret_token for setWebhook
NUXT_TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Mini App HTTPS URL for Open / Menu Button web_app (defaults to request origin)
# NUXT_TELEGRAM_MINI_APP_URL=https://your-pages-domain.example

# Database password / session pooler URL — for `npm run db:push` (IPv4)
# Dashboard → Connect → Session pooler
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Browser mock Telegram initData — only for local/dev (must be exactly "true")
# Local only — never enable on Cloudflare/production (server also blocks NODE_ENV=production)
NUXT_PUBLIC_ALLOW_TELEGRAM_DEV_MOCK=true

# Bot username without @ — native Mini App invites (t.me/bot?startapp=CODE)
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
