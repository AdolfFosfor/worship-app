# Cloudflare Pages: last matching rule wins per header.
# Keep a `/*` rule so Nitro does not append its own fallback.

# SPA HTML / Worker routes — never cache (Telegram WebView is aggressive).
/
  Cache-Control: no-store

/*
  Cache-Control: no-store

# Hashed Vite assets — safe to cache forever.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Build id probe must always revalidate (overrides /_nuxt/* above).
/_nuxt/builds/latest.json
  Cache-Control: no-cache
